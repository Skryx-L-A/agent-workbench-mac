#!/bin/bash
# starten [--kopflos|--ohne-fokus] [--terminal strom|attach] [--stop] [--status]
#
# Startet die Mac-App, und die App startet ihren Kern (app/ kopflos) selbst
# als eigenes Kind (Kernstart.swift) -- kopflos ohne sichtbares Fenster fuer
# Pruefungen, sonst sichtbar.
#
# DIE APP IST ELTERNPROZESS DES KERNS (14.10.2026, Auftrag wz-mantel2). Bis
# dahin startete dieses Skript den Kern selbst und die App daneben. Der Kern
# erkennt die App aber an der Peer-PID ihrer Verbindung (= process.ppid,
# mantel.ts): auf dem alten Weg galt die App als fremd, und eine fremde
# Verbindung darf weder tippen noch freigeben. Deshalb setzt das Skript
# AWB_MANTEL_SOCKET/AWB_MANTEL_TOKEN NICHT mehr (und entfernt geerbte), damit
# Kernstart.swift greift; den Kernordner gibt es als AWB_APP_DIR mit.
#
# --ohne-fokus liegt dazwischen: das Fenster steht auf dem Bildschirm (nur dann
# zeichnet AppKit eine `List` oder eine `Table`), aber die App wird nie aktiviert
# -- fuer eine Sichtpruefung mit `wb-shot`, waehrend ein Mensch an derselben
# Maschine arbeitet (regeln/aufnahmen.md).
#
# Laufverzeichnis: $AWBMAC_LAUFDIR, Vorgabe ~/.config/agent-workbench/mac-lauf.
# Darin: kern.pid, app.pid, kern.log, app.log, mantel.sock (Kern <-> App),
# awb.sock (Steuerkanal des Kerns, awb-ctl), awbmac.sock (awbmac-ctl).
#
# Alles, was der Kern sonst aus der Umgebung liest (AWB_TMUX_SOCKET,
# AWB_SESSIONS_DIR, AWB_STATE_DIR, HOME …), reist unveraendert durch -- eine
# Pruefung setzt es auf ihre Wegwerf-Umgebung, ein Mensch laesst es weg.
#
# Der Steuerkanal des Kerns liegt HIER, nicht auf dem Vorgabepfad
# (awb-<uid>.sock): dort lauscht die laufende Electron-Werkbank, und zwei
# Kerne an einem Pfad gibt es nicht (control.ts, clearStaleSocket).
set -uo pipefail
MAC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(cd "$MAC/.." && pwd)"
# Zwei Kandidaten fuer app/, wie Kernstart.swift kernPfadFinden (06.09.2026,
# Nachtrag 15.09. fuer das veroeffentlichte Mac-Repo): im bewohnten Baum liegt
# app/ neben mac/ (REPO/app, unveraendert). Im veroeffentlichten Mac-Repo (ohne
# mac/-Praefix, publish/baue-repo.sh --umfang mac) liegt dort kein app/ mehr --
# der Kern kommt aus einem daneben geklonten Geschwister-Repo agent-workbench
# (Umfang werkbank), siehe INSTALL.md. Ein blosses `cd` reicht nicht, weil ein
# unfertiger Klon (kein npm-Bau) sonst als Kern durchginge und erst beim Start
# scheitert -- dieselbe Pruefung wie Kernstart.istKern.
APP_KERN="$REPO/app"
if ! { [ -f "$APP_KERN/package.json" ] && [ -f "$APP_KERN/dist/main/main.js" ]; }; then
  GESCHWISTER="$REPO/agent-workbench/app"
  { [ -f "$GESCHWISTER/package.json" ] && [ -f "$GESCHWISTER/dist/main/main.js" ]; } && APP_KERN="$GESCHWISTER"
fi
LAUF="${AWBMAC_LAUFDIR:-$HOME/.config/agent-workbench/mac-lauf}"
KOPFLOS=0; OHNE_FOKUS=0; STOP=0; STATUS=0; ART="${AWBMAC_TERMINAL:-strom}"
while [ $# -gt 0 ]; do
  case "$1" in
    --kopflos) KOPFLOS=1 ;;
    --ohne-fokus) OHNE_FOKUS=1 ;;
    --terminal) shift; ART="$1" ;;
    --terminal=*) ART="${1#--terminal=}" ;;
    --stop) STOP=1 ;;
    --status) STATUS=1 ;;
    -h|--help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "starten: unbekannte Angabe '$1'" >&2; exit 2 ;;
  esac
  shift
done
mkdir -p "$LAUF"
# Den Mantel legt die App an (Kernstart.swift: <laufdir>/mantel.sock, Token je
# Lauf). Geerbte Werte -- etwa aus dem tmux-Env eines Agenten -- wuerden die App
# an einen fremden Kern haengen, also weg damit.
#
# DASSELBE GILT FUER DEN STEUERKANAL DES KERNS (14.10.2026, Review-Fund F1b):
# ein Agenten-Pane traegt AWB_CONTROL_SOCKET des LAUFENDEN Kerns (awb-<uid>.sock,
# gemessen). Uebernommen, schickte `stoppen` sein `quit` an Kern des Nutzers, und
# der neue Kern wollte am selben Pfad lauschen. Der Kern dieses Laufs lauscht
# deshalb immer im Laufverzeichnis, und nur dorthin geht ein `quit`.
MANTEL_SOCK="$LAUF/mantel.sock"
unset AWB_MANTEL_SOCKET AWB_MANTEL_TOKEN AWB_CONTROL_SOCKET
export AWBMAC_LAUFDIR="$LAUF"
export AWB_APP_DIR="$APP_KERN"
export AWB_CONTROL_SOCKET="$LAUF/awb.sock"
export AWBMAC_CONTROL_SOCKET="${AWBMAC_CONTROL_SOCKET:-$LAUF/awbmac.sock}"
export AWBMAC_TERMINAL="$ART"
CTL="$MAC/bin/awbmac-ctl"

lebt() { local p; p="$(cat "$1" 2>/dev/null)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; }

# Ein Unix-Socket traegt hoechstens 103 Bytes Pfad (sun_path). Ein laengerer
# Pfad liesse den Kern starten und die App scheitern (gemessen 06.09.: EINVAL
# beim listen, der Kern blieb stehen). Also VOR dem ersten Prozess pruefen.
pfad_pruefen() {
  local p
  for p in "$MANTEL_SOCK" "$AWB_CONTROL_SOCKET" "$AWBMAC_CONTROL_SOCKET"; do
    if [ "${#p}" -gt 103 ]; then
      echo "starten: Socketpfad laenger als 103 Bytes (sun_path): $p -- kuerzeres AWBMAC_LAUFDIR waehlen" >&2
      return 1
    fi
  done
}

# Der Kern DIESES Laufverzeichnisses ohne PID-Datei: die kopflosen Electron-
# Prozesse dieses app/-Ordners (Kernstart startet `…/MacOS/Electron <app>`,
# aeltere Laeufe `…/.bin/electron <app>`, daher `lectron`), deren Umgebung
# unseren Mantel-Socket traegt
# (ps -E zeigt die Umgebung eigener Prozesse). Faengt den Fall, dass die
# PID-Datei weg ist (Laufverzeichnis geloescht, Datei ueberschrieben), ohne je
# einen fremden Kern zu treffen: ein anderes Laufverzeichnis hat einen anderen
# Socketpfad.
kern_ohne_pid() {
  local p
  for p in $(pgrep -f "lectron $APP_KERN --headless" 2>/dev/null); do
    if ps -E -o command= -p "$p" 2>/dev/null | tr ' ' '\n' | grep -qx "AWB_MANTEL_SOCKET=$MANTEL_SOCK"; then
      echo "$p"
    fi
  done
}

# IST <pid> DER KERN DIESES LAUFVERZEICHNISSES? (14.10.2026, Review-Fund F1a/c)
# Eine PID-Datei allein beweist nichts: nach einem Neustart der Maschine oder
# einem Absturz kann ihre Nummer einem fremden Prozess gehoeren (bis dahin
# genuegte `kill -0`, und baum_beenden haette dessen ganzen Baum beendet, im
# schlimmsten Fall einen tmux-Server). Verlangt werden deshalb das Kommando des
# Kerns (`…lectron <app> --headless`), UNSER Mantel-Socket in seiner Umgebung
# (`ps -E`; nur Name=Wert verglichen, nichts ausgegeben -- dort steht auch der
# Token) und, mit <pid-datei>, ein Prozessstart nicht nach dem Schreiben der
# Datei (Kernstart.swift schreibt kern.pid direkt nach dem Start).
kern_ist_unserer() {
  local p="$1" datei="${2:-}" cmd alter mtime
  cmd="$(ps -ww -o command= -p "$p" 2>/dev/null)" || return 1
  case "$cmd" in *"lectron $APP_KERN --headless"*) ;; *) return 1 ;; esac
  ps -ww -E -o command= -p "$p" 2>/dev/null | tr ' ' '\n' | grep -qx "AWB_MANTEL_SOCKET=$MANTEL_SOCK" || return 1
  [ -n "$datei" ] || return 0
  alter="$(prozess_alter "$p")" || return 1
  mtime="$(stat -f %m "$datei" 2>/dev/null)" || return 1
  # Start = jetzt - Alter; 2 s Spiel fuer die Rundung von etime und mtime.
  [ $(( $(date +%s) - alter )) -le $(( mtime + 2 )) ]
}

# Alter eines Prozesses in Sekunden aus `ps -o etime=` ([[tt-]hh:]mm:ss).
prozess_alter() {
  local e t=0 tage=0 teil
  e="$(ps -o etime= -p "$1" 2>/dev/null | tr -d ' ')"
  [ -n "$e" ] || return 1
  case "$e" in *-*) tage="${e%%-*}"; e="${e#*-}" ;; esac
  local IFS=:
  for teil in $e; do t=$(( t*60 + 10#$teil )); done
  echo $(( tage*86400 + t ))
}

# Haengt <pid> an einer LEBENDEN Werkbank-App? Dann gehoert der Kern ihr -- etwa
# der App, die der Nutzer aus Dock oder Finder gestartet hat und die keine app.pid
# schreibt (die schreibt nur dieses Skript). Ein solcher Kern wird nie beendet.
# Erkannt am Kommando des Elternprozesses (auch die Test-Attrappe, ein Skript
# unter `…/MacOS/Werkbank`, steht dort mit ihrem Pfad).
kern_hat_app() {
  local pp cmd
  pp="$(ps -o ppid= -p "$1" 2>/dev/null | tr -d ' ')"
  [ -n "$pp" ] && [ "$pp" != 1 ] || return 1
  cmd="$(ps -ww -o command= -p "$pp" 2>/dev/null)" || return 1
  case " $cmd " in *"/MacOS/Werkbank "*) echo "$pp"; return 0 ;; esac
  return 1
}

# Haelt eine Werkbank-App die Einzelinstanz-Sperre dieses Laufverzeichnisses
# (Einzelinstanz.swift: flock auf <laufdir>/instanz.lock)? Probeweise sperren und
# sofort wieder freigeben; fehlt die Datei, haelt sie niemand.
instanz_belegt() {
  [ -e "$LAUF/instanz.lock" ] || return 1
  perl -MFcntl=:flock -e 'open(my $f, "<", $ARGV[0]) or exit 1; exit(flock($f, LOCK_EX|LOCK_NB) ? 1 : 0)' "$LAUF/instanz.lock"
}

# Dasselbe fuer die App: Werkbank-Prozesse, deren Umgebung UNSEREN Steuerkanal traegt.
app_ohne_pid() {
  local p
  for p in $(pgrep -f "Werkbank.app/Contents/MacOS/Werkbank" 2>/dev/null); do
    if ps -E -o command= -p "$p" 2>/dev/null | tr ' ' '\n' | grep -qx "AWBMAC_CONTROL_SOCKET=$AWBMAC_CONTROL_SOCKET"; then
      echo "$p"
    fi
  done
}

# Einen Prozessbaum sicher beenden: erst TERM an ALLE Nachkommen (nicht nur
# die direkten Kinder) und die Wurzel, dann KILL an alles, was noch lebt.
#
# REKURSIV, NICHT NUR EINE EBENE (08.09.2026, Gegenlesen-Nachtrag): ein
# gemessener LAUFENDER Kern zeigt drei Ebenen -- Node-Wrapper (das ist
# kern.pid) -> echter Electron-Prozess -> "Electron Helper --type=gpu-
# process". `pgrep -P` nur auf die Wurzel angewendet erreichte bisher bloss
# die zweite Ebene; der GPU-Helfer (dritte Ebene, Kind des echten Electron-
# Prozesses) blieb unentdeckt -- und in den bisherigen Proben dieses Auftrags
# nie geprueft, weil das Suchmuster dort nur auf "electron ... --headless"
# passte, nicht auf "Electron Helper ...". Jetzt werden alle Ebenen VOR dem
# ersten `kill` eingesammelt.
#
# <frist-sekunden> (Vorgabe 3): wie lange auf ein sauberes Ende nach TERM
# gewartet wird, bevor KILL nachgesetzt wird. `abbruch()` uebergibt im
# Signalpfad eine kuerzere Frist -- siehe dort.
baum_beenden() {
  local wurzel="$1" frist="${2:-3}" alle schicht neue kind enkel
  # Getrennt von der `local`-Zeile darueber, nicht darin (gemessen: `local
  # a=1 b="$a"` sieht $a unter `set -u` noch als unbound, weil `local` seine
  # eigenen Bindungen erst NACH der ganzen Zeile herstellt).
  alle="$wurzel"; schicht="$wurzel"
  while [ -n "$schicht" ]; do
    neue=""
    for kind in $schicht; do
      for enkel in $(pgrep -P "$kind" 2>/dev/null); do
        case " $alle " in
          *" $enkel "*) ;;
          *) neue="$neue $enkel"; alle="$alle $enkel" ;;
        esac
      done
    done
    schicht="$neue"
  done
  kill $alle 2>/dev/null
  local d=$((SECONDS+frist)); while [ $SECONDS -lt $d ] && kill -0 "$wurzel" 2>/dev/null; do sleep 0.2; done
  for p in $alle; do kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null; done
  return 0
}

# Den Kern <pid> beenden: erst hoeflich ueber den Steuerkanal DIESES Laufs (nie
# einen geerbten), dann den ganzen Baum.
kern_beenden() {
  local p="$1" d
  node "$APP_KERN/bin/awb-ctl" --socket "$LAUF/awb.sock" quit >/dev/null 2>&1
  d=$((SECONDS+8)); while [ $SECONDS -lt $d ] && kill -0 "$p" 2>/dev/null; do sleep 0.2; done
  kill -0 "$p" 2>/dev/null && baum_beenden "$p"
  return 0
}

stoppen() {
  local p a verschont=0
  if p="$(lebt "$LAUF/app.pid")"; then
    "$CTL" quit >/dev/null 2>&1
    local d=$((SECONDS+5)); while [ $SECONDS -lt $d ] && kill -0 "$p" 2>/dev/null; do sleep 0.2; done
    kill -0 "$p" 2>/dev/null && kill "$p" 2>/dev/null
    sleep 0.5; kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null
  fi
  # Erst alle Apps dieses Laufs, dann die Kerne: haengt danach noch ein Kern an
  # einer lebenden Werkbank-App, ist es nicht unsere (kern_hat_app) und er bleibt.
  for p in $(app_ohne_pid); do
    echo "starten --stop: App ohne PID-Datei gefunden (PID $p), wird beendet" >&2
    baum_beenden "$p"
  done
  if p="$(lebt "$LAUF/kern.pid")"; then
    if ! kern_ist_unserer "$p" "$LAUF/kern.pid"; then
      echo "starten --stop: kern.pid nennt PID $p, das ist nicht der Kern dieses Laufs -- nicht beendet" >&2
    elif a="$(kern_hat_app "$p")"; then
      echo "starten --stop: der Kern (PID $p) gehoert der laufenden Werkbank-App $a -- nicht beendet" >&2
      verschont=1
    else
      kern_beenden "$p"
    fi
  fi
  # Und was die PID-Datei nicht kennt (06.09.: ein Kern blieb stehen, weil sein
  # Laufverzeichnis nicht mehr zur Datei passte): jeden Kern mit UNSEREM
  # Mantel-Socket in der Umgebung beenden -- ausser er haengt an einer App.
  for p in $(kern_ohne_pid); do
    if a="$(kern_hat_app "$p")"; then
      echo "starten --stop: der Kern (PID $p) gehoert der laufenden Werkbank-App $a -- nicht beendet" >&2
      verschont=1; continue
    fi
    echo "starten --stop: Kern ohne PID-Datei gefunden (PID $p), wird beendet" >&2
    baum_beenden "$p"
  done
  # Lebt hier noch eine fremde Werkbank (ein verschonter Kern, eine App mit der
  # Einzelinstanz-Sperre), gehoeren PID-Dateien und Sockets ihr: liegen lassen,
  # sonst verliert ihre App den Mantel und `awbmac-ctl` den Steuerkanal.
  if [ "$verschont" = 1 ] || instanz_belegt; then
    echo "starten --stop: eine andere Werkbank lebt in $LAUF -- ihre Sockets und PID-Dateien bleiben" >&2
    rm -f "$LAUF/app.pid"
    return 0
  fi
  rm -f "$LAUF/app.pid" "$LAUF/kern.pid" "$LAUF/mantel.sock" "$LAUF/awbmac.sock"
  [ "$AWB_CONTROL_SOCKET" = "$LAUF/awb.sock" ] && rm -f "$LAUF/awb.sock"
  return 0
}

status() {
  local k a
  k="$(lebt "$LAUF/kern.pid")" || k=""
  a="$(lebt "$LAUF/app.pid")" || a=""
  echo "Laufverzeichnis: $LAUF"
  echo "Kern: ${k:-laeuft nicht}   App: ${a:-laeuft nicht}   Terminal: $ART"
  [ -n "$k" ] && [ -n "$a" ]
}

if [ "$STOP" = 1 ]; then stoppen; echo "beendet"; exit 0; fi
if [ "$STATUS" = 1 ]; then status; exit $?; fi
pfad_pruefen || exit 1

# WER HIER STARTET, RAEUMT BEI ABBRUCH AUCH AUF (06.09.2026): bis dahin liess
# ein gescheiterter App-Start den eben gestarteten Kern stehen -- kein Fenster,
# kein Aufraeumer, ein Electron-Baum als Waise. Was dieser Aufruf selbst
# gestartet hat, beendet er bei jedem Fehlerausgang wieder; ein Kern, der schon
# lief, bleibt in Ruhe (der gehoert einem anderen Aufruf).
#
# DASSELBE GILT FUER EIN SIGNAL VON AUSSEN (08.09.2026, Folgeauftrag waisen):
# ohne einen eigenen `trap` stirbt dieses Skript an einem externen TERM/INT/HUP
# sofort und OHNE abbruch() je aufzurufen -- gemessen fuehrte genau das zu
# liegenbleibenden Kernen: `shell/tests/run-all.sh` haengt jede Suite in
# `timeout 300 ...` OHNE `--foreground` und OHNE `-k`; GNU timeout legt das
# Kommando dabei in eine EIGENE Prozessgruppe und schickt beim Ablauf TERM an
# die ganze Gruppe. Braucht eine Suite unter Last laenger als ihr Zeitfenster,
# waehrend `starten` gerade auf Kern- oder App-Bereitschaft wartet, trifft
# dasselbe TERM `starten` UND den gerade gestarteten Kern/App gleichzeitig --
# und ohne eigenen `trap` beendet sich `starten` sofort, ohne den Kern/die App
# zu verifizieren oder notfalls mit KILL nachzufassen. Reagiert der Kern/die
# App nicht sofort auf sein eigenes TERM (naheliegend: er haengt ja gerade
# deshalb, weil er noch nicht fertig initialisiert ist), bleibt er als Waise
# stehen -- PPID 1, niemand schickt je ein KILL nach. Nachgestellt mit einem
# haengenden Ersatz-Kern unter `timeout 3 mac/bin/starten --kopflos`: ohne
# diesen `trap` blieb der Ersatz-Kern nachweislich am Leben, RC=124, leeres
# Protokoll (starten kam nicht einmal bis zur ersten Log-Zeile). Der `trap`
# hier macht ein externes Signal zu genau demselben Fall wie ein interner
# Fehlerausgang: `abbruch` raeumt auf, was DIESER Aufruf selbst gestartet hat.
# GEGENLESEN 08.09.2026 (zweite Runde, Commit 17a96f4 geprueft) -- vier
# eigenstaendige Nachbesserungen an diesem `trap`/`abbruch`-Mechanismus:
#
#   1  WIEDEREINTRITT: `abbruch` schaltet sich als ALLERERSTES selbst ab
#      (`trap '' TERM INT HUP`, `trap - EXIT`). Ohne das koennte ein zweites
#      Signal waehrend des laufenden Aufraeumens (baum_beenden/stoppen
#      brauchen bis zu ein paar Sekunden) `abbruch` ein zweites Mal anstossen
#      -- doppelte baum_beenden-Aufrufe auf denselben PIDs, verdoppelte
#      Log-Zeilen, ein unklarer Endzustand.
#
#   2  PID-WIEDERVERWENDUNG: `p="$(cat app.pid)"` ohne Lebendpruefung wuerde
#      im (seltenen) Fall, dass die App zwischen dem Schreiben der PID-Datei
#      und diesem Zeitpunkt schon gestorben ist UND die Nummer inzwischen ein
#      voellig anderer Prozess traegt, genau DIESEN fremden Prozess treffen.
#      `lebt()` (dieselbe Pruefung, die `stoppen()` schon ueberall benutzt)
#      schliesst das nicht vollstaendig aus, aber verlangt wenigstens, dass
#      UEBERHAUPT ein Prozess mit dieser Nummer lebt, statt blind zu kill'en.
#
#   3  EXIT-CODE: ein Abbruch durch TERM/INT/HUP endete bisher wie ein
#      gewoehnlicher Startfehler (`exit 1`) -- ununterscheidbar fuer den
#      Aufrufer (run-all.sh, ein Mensch). Jetzt 128+Signalnummer (143 fuer
#      TERM, 130 fuer INT, 129 fuer HUP), der ueblichen Shell-Konvention
#      folgend; ein interner Fehlerausgang (kein Signal) bleibt bei `exit 1`.
#
#   4  ZEITDECKEL IM SIGNALPFAD: der bisherige Weg (volles `stoppen()` mit
#      hoeflicher RPC-Anfrage an den Kern, 5+8 Sekunden Wartezeit, dazu
#      `baum_beenden`s eigene 3 Sekunden) kann fast 16 Sekunden dauern. Steht
#      bereits EIN Signal gegen uns (ein `timeout -k`, ein zweites Ctrl-C),
#      ist unklar, ob wir ueberhaupt so lange leben -- werden WIR vorher
#      abgeschossen, kommt das KILL an Kern/App nie raus. Im Signalpfad
#      deshalb sofort auf eine kurze Frist (1 Sekunde TERM-Wartezeit, dann
#      KILL) umstellen, ohne den Umweg ueber die hoefliche RPC-Anfrage --
#      dafuer ist keine Zeit mehr, wenn schon ein Signal gegen uns steht. Der
#      interne Fehlerausgang (kein akutes Aussensignal) behaelt die
#      grosszuegigeren Fristen von `stoppen()`.
#
# Registriert wird mit drei Auspraegungen von $1: eine Signalnummer (TERM/
# INT/HUP, siehe die drei `trap`-Zeilen unten) fuer ein echtes Aussensignal,
# das Wort "EXIT" fuer den Fangnetz-Trap unten (Risiko 5: ein harter Ausstieg
# ohne Signal, z. B. eine unter `set -u` unerwartet unbelegte Variable, soll
# denselben Waisen nicht hinterlassen) -- dort wird NICHT `exit` aufgerufen,
# damit der urspruengliche Exit-Code erhalten bleibt --, und kein Argument
# fuer die bestehenden internen Fehlerausgaenge (Kern/App-Bereitschaft nicht
# erreicht), die weiterhin `exit 1` wollen.
KERN_SELBST=0
APP_SELBST=0
abbruch() {
  local sig="${1:-}" frist=3 p
  trap '' TERM INT HUP
  trap - EXIT
  case "$sig" in ''|EXIT) ;; *) frist=1 ;; esac

  if [ "$APP_SELBST" = 1 ]; then
    echo "starten: raeume die eben gestartete App wieder ab" >&2
    p="$(lebt "$LAUF/app.pid")" && baum_beenden "$p" "$frist"
    rm -f "$LAUF/app.pid"
    APP_SELBST=0
  fi
  if [ "$KERN_SELBST" = 1 ]; then
    echo "starten: raeume den eben gestarteten Kern wieder ab" >&2
    if [ "$sig" != '' ] && [ "$sig" != EXIT ]; then
      p="$(lebt "$LAUF/kern.pid")" && baum_beenden "$p" "$frist"
      rm -f "$LAUF/kern.pid" "$LAUF/mantel.sock"
      [ "$AWB_CONTROL_SOCKET" = "$LAUF/awb.sock" ] && rm -f "$LAUF/awb.sock"
    else
      stoppen
    fi
    KERN_SELBST=0
  fi

  case "$sig" in
    EXIT) return 0 ;;                    # urspruenglichen Exit-Code NICHT ueberschreiben
    '') exit 1 ;;                        # interner Fehlerausgang, wie bisher
    *) exit $((128+sig)) ;;              # echtes Signal: 128+Signalnummer
  esac
}
trap 'abbruch 15' TERM
trap 'abbruch 2' INT
trap 'abbruch 1' HUP
trap 'abbruch EXIT' EXIT

# Erfolgreicher Abschluss: die beiden SELBST-Merker zuruecksetzen und JEDEN
# trap wieder abschalten, BEVOR ein `exit 0` diesen Punkt verlaesst (Risiko 7:
# sonst raeumt ein Signal, das GENAU zwischen dem letzten Bereitschafts-Beweis
# und dem Skriptende eintrifft, einen fertig gestarteten, gesund laufenden
# Kern/App wieder ab -- fuer den ist der Aufruf ja gerade erfolgreich zu Ende).
# Zwei Fundstellen brauchen das, nicht nur die letzte Zeile der Datei: auch
# der fruehe Erfolgsausgang "App laeuft bereits" weiter unten, wenn DIESER
# Aufruf selbst gerade noch den Kern gestartet hat (KERN_SELBST=1) und nur die
# App schon anderweitig lief.
erfolg() { KERN_SELBST=0; APP_SELBST=0; trap - TERM INT HUP EXIT; exit 0; }

# Die Electron-Binaerdatei, die Kernstart.swift startet (electronPfad) -- nicht
# der Node-Shim `.bin/electron`.
ELECTRON="$APP_KERN/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
[ -x "$ELECTRON" ] || { echo "starten: app/node_modules fehlt -- 'npm install' in app/" >&2; exit 1; }
[ -f "$APP_KERN/dist/main/main.js" ] || (cd "$APP_KERN" && npm run build >/dev/null 2>&1) || { echo "starten: app/dist fehlt und laesst sich nicht bauen" >&2; exit 1; }
WERKBANK="$MAC/build/Werkbank.app/Contents/MacOS/Werkbank"
[ -x "$WERKBANK" ] || { echo "starten: $WERKBANK fehlt -- mac/bin/bauen" >&2; exit 1; }

if p="$(lebt "$LAUF/app.pid")"; then
  echo "App laeuft bereits (PID $p)"
  if k="$(lebt "$LAUF/kern.pid")"; then echo "Kern laeuft (PID $k), Steuerkanal $AWB_CONTROL_SOCKET"
  else echo "starten: die App laeuft, ihr Kern nicht -- 'starten --stop' und neu starten" >&2; fi
  erfolg
fi
# Ein Kern ohne App hat keine App als Elternprozess (eine abgestuerzte App, ein
# Lauf auf dem alten Weg). Die App startet gleich ihren eigenen; der alte hielte
# sonst den Mantel-Socket (mantel.ts bindet keinen zweiten) und naehme die neue
# App als fremd.
#
# KERN des Nutzers NIE (14.10.2026, Review-Fund F1): die App aus Dock oder Finder
# schreibt keine app.pid, ihr Kern stuende hier sonst als "Kern ohne App" da.
# Zwei unabhaengige Riegel, beide vor dem ersten Signal:
#   1  Haelt eine App die Einzelinstanz-Sperre dieses Laufverzeichnisses, laeuft
#      dort schon eine Werkbank. Unsere App wuerde ohnehin sofort weichen
#      (Einzelinstanz), also abbrechen, ohne irgendetwas zu beenden.
#   2  Jeder Kandidat muss der Kern DIESES Laufs sein (kern_ist_unserer:
#      Kommando, Mantel-Socket, Startzeit gegen kern.pid), und keiner darf an
#      einer lebenden Werkbank-App haengen (kern_hat_app) -- sonst ebenfalls
#      abbrechen. Riegel 2 deckt eine App, die die Sperre (noch) nicht haelt:
#      eine aeltere Fassung ohne instanz.lock oder ein anderes Laufverzeichnis
#      der Sperre.
# Erst wenn alle Kandidaten geprueft sind, wird einer beendet.
if instanz_belegt; then
  echo "starten: eine Werkbank-App haelt $LAUF/instanz.lock -- dort laeuft schon eine Werkbank; nichts beendet, nichts gestartet" >&2
  exit 1
fi
KANDIDATEN=""
if p="$(lebt "$LAUF/kern.pid")"; then
  if kern_ist_unserer "$p" "$LAUF/kern.pid"; then KANDIDATEN="$p"
  else echo "starten: kern.pid nennt PID $p, das ist nicht der Kern dieses Laufs -- nicht beendet" >&2; fi
fi
for p in $(kern_ohne_pid); do
  case " $KANDIDATEN " in *" $p "*) ;; *) KANDIDATEN="$KANDIDATEN $p" ;; esac
done
for p in $KANDIDATEN; do
  if a="$(kern_hat_app "$p")"; then
    echo "starten: der Kern (PID $p) gehoert der laufenden Werkbank-App $a -- nichts beendet, nichts gestartet" >&2
    exit 1
  fi
done
for p in $KANDIDATEN; do
  echo "starten: Kern ohne App (PID $p) wird beendet, die App startet ihren eigenen" >&2
  kern_beenden "$p"
done
# Ohne alte PID-Datei und altes Protokoll: Bereitschaft heisst eine awb-ready-Zeile
# des NEUEN Kerns, dessen PID die App schreibt.
rm -f "$LAUF/kern.pid"; : > "$LAUF/kern.log"

ARGS=(--terminal "$ART")
[ "$KOPFLOS" = 1 ] && ARGS+=(--kopflos)
[ "$OHNE_FOKUS" = 1 ] && ARGS+=(--ohne-fokus)
: > "$LAUF/app.log"
"$WERKBANK" "${ARGS[@]}" >>"$LAUF/app.log" 2>&1 &
echo $! > "$LAUF/app.pid"
# Der Kern dieses Laufs gehoert der App, die DIESER Aufruf startet: bricht der
# Start ab, gehen beide (baum_beenden auf die App erfasst den Kern als Kind,
# der KERN_SELBST-Zweig von abbruch() faengt einen Kern, der sich geloest hat).
APP_SELBST=1
KERN_SELBST=1
kern_bereit() { grep -q '^awb-ready ' "$LAUF/kern.log" 2>/dev/null && [ -n "$(lebt "$LAUF/kern.pid")" ]; }
d=$((SECONDS+60))
while [ $SECONDS -lt $d ]; do
  kern_bereit && break
  kill -0 "$(cat "$LAUF/app.pid")" 2>/dev/null || { echo "starten: die App ist sofort wieder beendet:" >&2; tail -15 "$LAUF/app.log" >&2; abbruch; }
  if [ -s "$LAUF/kern.pid" ] && [ -z "$(lebt "$LAUF/kern.pid")" ]; then
    echo "starten: der Kern ist sofort wieder beendet:" >&2; tail -15 "$LAUF/kern.log" >&2; abbruch
  fi
  sleep 0.3
done
kern_bereit || { echo "starten: der Kern meldete keine Bereitschaft (60 s)" >&2; tail -15 "$LAUF/kern.log" >&2 2>/dev/null; tail -15 "$LAUF/app.log" >&2; abbruch; }
echo "Kern laeuft (PID $(cat "$LAUF/kern.pid")), Steuerkanal $AWB_CONTROL_SOCKET"

d=$((SECONDS+30))
while [ $SECONDS -lt $d ]; do
  "$CTL" ping >/dev/null 2>&1 && break
  # Kein `rm -f app.pid` hier mehr VOR abbruch (08.09.2026, derselbe Fehler wie
  # beim `trap` oben, nur ohne externes Signal): abbruch()/APP_SELBST braucht
  # die PID-Datei noch, um die App zuverlaessig (mit KILL-Nachfassen) zu
  # beenden, statt sie nur aus der Buchhaltung zu streichen.
  kill -0 "$(cat "$LAUF/app.pid")" 2>/dev/null || { echo "starten: die App ist sofort wieder beendet:" >&2; tail -15 "$LAUF/app.log" >&2; abbruch; }
  sleep 0.2
done
# War hier vorher ein einzelnes unverifiziertes `kill` (SIGTERM) gefolgt von
# sofortigem `rm -f app.pid` -- ignoriert die App das TERM (z. B. weil sie noch
# nicht so weit ist, es zu verarbeiten, exakt der Fall, der sie hier hinfuehrt),
# blieb sie als Waise stehen, ohne dass ihr je ein KILL nachgeschickt wurde.
# abbruch() (APP_SELBST=1) beendet jetzt mit demselben verifizierten
# TERM-dann-KILL wie baum_beenden ueberall sonst in diesem Skript.
"$CTL" ping >/dev/null 2>&1 || { echo "starten: die App meldete keinen Steuerkanal (30 s)" >&2; tail -15 "$LAUF/app.log" >&2; abbruch; }
if [ "$KOPFLOS" = 1 ]; then echo "App laeuft kopflos (PID $(cat "$LAUF/app.pid")), Steuerkanal $AWBMAC_CONTROL_SOCKET"
elif [ "$OHNE_FOKUS" = 1 ]; then echo "App laeuft sichtbar ohne Fokus (PID $(cat "$LAUF/app.pid")), Steuerkanal $AWBMAC_CONTROL_SOCKET"
else echo "App laeuft sichtbar (PID $(cat "$LAUF/app.pid"))"; fi
erfolg
